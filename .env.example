# VenLinks PRO deployment environment
# Docker: copy this file to .env in the repository root.
# Source development: copy it to web/.env.local and change DATABASE_URL host to localhost.

# Required public URL. Production should use the externally reachable HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Docker host port. Containers and internal service calls continue to use port 3000.
VENLINKS_PRO_HOST_PORT=3002

# Optional image override. Use venlinks-pro:local when building on the server.
VENLINKS_PRO_IMAGE=ghcr.io/csyqlz/venlinks-pro:latest

# Source-build mirrors. docker-compose.local.yml uses these China-accessible defaults;
# override them only when your server has a faster private or regional mirror.
VENLINKS_PRO_NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
VENLINKS_PRO_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
VENLINKS_PRO_NPM_REGISTRY=https://registry.npmmirror.com
VENLINKS_PRO_DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
VENLINKS_PRO_DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security

# Default Docker Compose creates this PostgreSQL database and overrides DATABASE_URL with host `postgres`.
POSTGRES_DB=venlinks_pro
POSTGRES_USER=venlinks_pro
POSTGRES_PASSWORD=

# Source deployment and external PostgreSQL connection.
VENLINKS_PRO_DATABASE_PROVIDER=postgres
DATABASE_URL=
VENLINKS_PRO_DATABASE_POOL_MAX=10
# Local/Docker PostgreSQL normally uses 0. Managed cloud PostgreSQL commonly requires 1.
VENLINKS_PRO_DATABASE_SSL=0

# Required in production. Must be 64 hexadecimal characters or exact 32-byte Base64.
# Generate once with `openssl rand -hex 32`, keep it stable, and never commit the real value.
VENLINKS_PRO_ENCRYPTION_KEY=

# Runtime paths and internal callbacks.
VENLINKS_PRO_DATA_DIR=/app/web/.data
VENLINKS_PRO_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Leave empty for automatic HTTP/HTTPS detection. Set true or false only for unusual proxies.
VENLINKS_PRO_COOKIE_SECURE=
# Reverse proxy hop count used for rate limiting client IPs. Set 1 for one trusted proxy.
VENLINKS_PRO_TRUSTED_PROXY_HOPS=0
# Optional local override when FFmpeg is not on PATH. Docker images already include FFmpeg.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy used by server-side model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Billing behavior.
VENLINKS_PRO_BILLING_ORDER_EXPIRES_MINUTES=30
# Optional token for deployment-neutral maintenance jobs. Use at least 32 random characters.
# Generate with `openssl rand -hex 32`, then call maintenance APIs with `Authorization: Bearer <token>`.
VENLINKS_PRO_MAINTENANCE_TOKEN=
# Worker polls the maintenance endpoint. Docker Compose sets this to http://app:3000.
VENLINKS_PRO_WORKER_API_ORIGIN=
VENLINKS_PRO_GENERATION_WORKER_ID=
VENLINKS_PRO_GENERATION_WORKER_INTERVAL_MS=2000
VENLINKS_PRO_GENERATION_WORKER_LANES=2
VENLINKS_PRO_GENERATION_WORKER_HEARTBEAT_MS=15000
VENLINKS_PRO_GENERATION_WORKER_STALE_MS=90000
# Optional generic generation webhook HMAC-SHA256 secret (at least 32 characters).
VENLINKS_PRO_GENERATION_WEBHOOK_SECRET=

# Optional work-publication moderation signal provider. Signals never auto-approve content.
# manual: always requires an administrator review (default).
# keywords: checks the comma/newline-separated keyword list below.
# http: POSTs public draft fields to the configured endpoint with a 3-second timeout.
VENLINKS_PRO_CONTENT_MODERATION_PROVIDER=manual
VENLINKS_PRO_CONTENT_MODERATION_KEYWORDS=
VENLINKS_PRO_CONTENT_MODERATION_URL=
VENLINKS_PRO_CONTENT_MODERATION_API_KEY=

# Optional Stripe configuration. It can also be saved from the admin payment settings page.
VENLINKS_PRO_STRIPE_SECRET_KEY=
VENLINKS_PRO_STRIPE_WEBHOOK_SECRET=
VENLINKS_PRO_STRIPE_API_BASE=https://api.stripe.com
VENLINKS_PRO_STRIPE_SUCCESS_URL=
VENLINKS_PRO_STRIPE_CANCEL_URL=
VENLINKS_PRO_STRIPE_PAYMENT_METHOD_TYPES=
VENLINKS_PRO_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Optional Alipay configuration.
VENLINKS_PRO_ALIPAY_MODE=official
VENLINKS_PRO_ALIPAY_APP_ID=
VENLINKS_PRO_ALIPAY_PRIVATE_KEY=
VENLINKS_PRO_ALIPAY_PRIVATE_KEY_PATH=
VENLINKS_PRO_ALIPAY_PUBLIC_KEY=
VENLINKS_PRO_ALIPAY_PUBLIC_KEY_PATH=
VENLINKS_PRO_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
VENLINKS_PRO_ALIPAY_NOTIFY_URL=
VENLINKS_PRO_ALIPAY_RETURN_URL=

# Optional WeChat Pay v3 configuration.
VENLINKS_PRO_WECHAT_PAY_APP_ID=
VENLINKS_PRO_WECHAT_PAY_MCH_ID=
VENLINKS_PRO_WECHAT_PAY_CERT_SERIAL_NO=
VENLINKS_PRO_WECHAT_PAY_PRIVATE_KEY=
VENLINKS_PRO_WECHAT_PAY_PRIVATE_KEY_PATH=
VENLINKS_PRO_WECHAT_PAY_API_V3_KEY=
VENLINKS_PRO_WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
VENLINKS_PRO_WECHAT_PAY_PLATFORM_PUBLIC_KEY=
VENLINKS_PRO_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
VENLINKS_PRO_WECHAT_PAY_PLATFORM_CERTIFICATE=
VENLINKS_PRO_WECHAT_PAY_PLATFORM_CERTIFICATE_PATH=
VENLINKS_PRO_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
VENLINKS_PRO_WECHAT_PAY_NOTIFY_URL=
VENLINKS_PRO_WECHAT_PAY_REFUND_NOTIFY_URL=
VENLINKS_PRO_WECHAT_PAY_WEBHOOK_TOLERANCE_SECONDS=300

# Optional PayPly/custom gateway configuration.
VENLINKS_PRO_PAYPLY_CHECKOUT_URL=
VENLINKS_PRO_PAYPLY_REFUND_URL=
VENLINKS_PRO_PAYPLY_API_KEY=
VENLINKS_PRO_PAYPLY_API_KEY_HEADER=
VENLINKS_PRO_PAYPLY_MERCHANT_ID=
VENLINKS_PRO_PAYPLY_REQUEST_METHOD=POST
VENLINKS_PRO_PAYPLY_CONTENT_TYPE=application/json
VENLINKS_PRO_PAYPLY_EXTRA_HEADERS=
VENLINKS_PRO_PAYPLY_REQUEST_TEMPLATE=
VENLINKS_PRO_PAYPLY_NOTIFY_URL=
VENLINKS_PRO_PAYPLY_RETURN_URL=
VENLINKS_PRO_PAYPLY_CANCEL_URL=
VENLINKS_PRO_PAYPLY_RESULT_KIND=
VENLINKS_PRO_PAYPLY_URL_FIELD=data.payUrl
VENLINKS_PRO_PAYPLY_QR_FIELD=data.qrContent
VENLINKS_PRO_PAYPLY_FORM_FIELD=data.formHtml
VENLINKS_PRO_PAYPLY_PROVIDER_ORDER_ID_FIELD=data.tradeId
VENLINKS_PRO_PAYPLY_PROVIDER_PAYMENT_ID_FIELD=data.paymentId
VENLINKS_PRO_PAYPLY_WEBHOOK_SECRET=
VENLINKS_PRO_PAYPLY_WEBHOOK_SIGNATURE_HEADER=x-signature
VENLINKS_PRO_PAYPLY_WEBHOOK_EVENT_ID_FIELD=id
VENLINKS_PRO_PAYPLY_WEBHOOK_EVENT_TYPE_FIELD=type
VENLINKS_PRO_PAYPLY_WEBHOOK_ORDER_ID_FIELD=data.orderId
VENLINKS_PRO_PAYPLY_WEBHOOK_ORDER_NO_FIELD=data.orderNo
VENLINKS_PRO_PAYPLY_WEBHOOK_STATUS_FIELD=data.status
VENLINKS_PRO_PAYPLY_WEBHOOK_SUCCESS_STATUSES=paid,success,succeeded,completed
VENLINKS_PRO_PAYPLY_WEBHOOK_TRADE_ID_FIELD=data.tradeId
VENLINKS_PRO_PAYPLY_WEBHOOK_PAYMENT_ID_FIELD=data.paymentId
VENLINKS_PRO_PAYPLY_WEBHOOK_AMOUNT_CENTS_FIELD=data.amountCents
VENLINKS_PRO_PAYPLY_WEBHOOK_AMOUNT_YUAN_FIELD=data.amount
VENLINKS_PRO_PAYPLY_WEBHOOK_CURRENCY_FIELD=data.currency
VENLINKS_PRO_PAYPLY_WEBHOOK_PAID_AT_FIELD=data.paidAt
VENLINKS_PRO_PAYPLY_REFUND_REQUEST_METHOD=POST
VENLINKS_PRO_PAYPLY_REFUND_CONTENT_TYPE=application/json
VENLINKS_PRO_PAYPLY_REFUND_EXTRA_HEADERS=
VENLINKS_PRO_PAYPLY_REFUND_REQUEST_TEMPLATE=
VENLINKS_PRO_PAYPLY_REFUND_ID_FIELD=data.refundId
VENLINKS_PRO_PAYPLY_REFUND_STATUS_FIELD=data.status
VENLINKS_PRO_PAYPLY_REFUND_SUCCESS_STATUSES=refunded,success,succeeded

# Generic signed callback fallback for /api/billing/webhooks/custom.
VENLINKS_PRO_PAYMENT_WEBHOOK_SECRET=
